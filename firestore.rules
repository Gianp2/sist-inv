rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isAuthenticated() && (
        !hasUserDoc() || getUserDoc().active == true
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'zvKPMDfIe0ZfwdikFBmhYCyq7w42' ||
        request.auth.token.email == 'admin@sistema.com' ||
        (hasUserDoc() && (
          getUserDoc().role == 'ADMIN' ||
          getUserDoc().role == 'DUEÑA' ||
          getUserDoc().role == 'DUENA' ||
          getUserDoc().role == 'SUPERADMIN'
        ))
      );
    }

    function isSupervisor() {
      return isAuthenticated() && isActive() && (
        isAdmin() || (hasUserDoc() && getUserDoc().role == 'SUPERVISOR')
      );
    }

    function isEmpleado() {
      return isAuthenticated() && isActive() && (
        isAdmin() || isSupervisor() ||
        (hasUserDoc() && (getUserDoc().role == 'EMPLEADO' || getUserDoc().role == 'CAJERO'))
      );
    }

    // Granular permission check:
    // 1. Admin always has full access
    // 2. If user doc has custom permissions and the permission key exists, check that boolean
    // 3. Fallback to role default condition
    function hasPermission(permKey, roleDefault) {
      return isAdmin() || (
        isAuthenticated() && isActive() && (
          (hasUserDoc() && ('permissions' in getUserDoc()) && getUserDoc().permissions != null && (permKey in getUserDoc().permissions))
            ? getUserDoc().permissions[permKey] == true
            : roleDefault
        )
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && (
          // When creating own profile, only admin email/UID can have ADMIN role
          request.resource.data.role != 'ADMIN' ||
          request.auth.uid == 'zvKPMDfIe0ZfwdikFBmhYCyq7w42' ||
          request.auth.token.email == 'admin@sistema.com'
        )
      );
      // Only ADMIN can change roles, permissions, or activate/deactivate users
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
      );
      allow delete: if isAdmin() && userId != 'zvKPMDfIe0ZfwdikFBmhYCyq7w42';
    }

    // SETTINGS COLLECTION (General store & Cloudinary config - Admin only write)
    match /settings/{settingId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasPermission('settings.edit', isAdmin());
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if hasPermission('categories.delete', isSupervisor());
    }

    // BRANDS
    match /brands/{brandId} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if hasPermission('brands.delete', isSupervisor());
    }

    // PRODUCTS
    match /products/{productId} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if hasPermission('products.delete', isSupervisor());
    }

    // CUSTOMERS
    match /customers/{customerId} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if hasPermission('customers.delete', isSupervisor());
    }

    // SUPPLIERS
    match /suppliers/{supplierId} {
      allow read: if hasPermission('suppliers.view', isSupervisor());
      allow create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }

    // SALES
    match /sales/{saleId} {
      allow read, create: if isAuthenticated() && isActive();
      allow update: if hasPermission('sales.edit', isSupervisor());
      allow delete: if isAdmin();
    }

    // PURCHASES (Sensitive supplier cost data)
    match /purchases/{purchaseId} {
      allow read: if hasPermission('purchases.view', isSupervisor());
      allow create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }

    // CASH REGISTERS (Shifts)
    match /cashRegisters/{registerId} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }

    // CASH MOVEMENTS
    match /cashMovements/{movementId} {
      allow read, create: if isAuthenticated() && isActive();
      allow update: if hasPermission('cash.edit', isSupervisor());
      allow delete: if isAdmin();
    }

    // STOCK MOVEMENTS
    match /stockMovements/{movId} {
      allow read, create: if isAuthenticated() && isActive();
      allow update, delete: if hasPermission('stock.delete', isAdmin());
    }

    // COST & PRICE HISTORIES
    match /costHistory/{id} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }
    match /priceHistory/{id} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }

    // CURRENT ACCOUNTS (Cuentas Corrientes - Clientes)
    match /currentAccounts/{id} {
      allow read, create, update: if isAuthenticated() && isActive();
      allow delete: if isAdmin();
    }
  }
}
